# Copy to .env and adjust:  cp .env.example .env
#
# Find the right values for your UPS with:
#   docker compose run --rm ups detect

# --- which UPS -------------------------------------------------------------
# Most USB UPSes (APC, Eaton, CyberPower, most modern models):
UPS_DRIVER=usbhid-ups

# Cheap "Q1/Megatec" UPSes (Armac, Powercom, Ippon, SVEN, many no-names).
# NOTE: with UPS_SUBDRIVER set, NUT requires the USB ids as well.
#UPS_DRIVER=nutdrv_qx
#UPS_SUBDRIVER=armac
#UPS_VENDORID=0925
#UPS_PRODUCTID=1234

# Optional: pin to one device when several USB UPSes are attached.
#UPS_SERIAL=

# Extra ups.conf lines, newline separated, e.g. "runtimecal = 240,100,1200,50"
#UPS_EXTRA=

# --- naming ----------------------------------------------------------------
UPS_NAME=ups
UPS_DESC=USB UPS

# --- network ---------------------------------------------------------------
LISTEN_PORT=3493

# --- client credentials ----------------------------------------------------
# Synology DSM logs in as monuser/secret and cannot be changed. Only touch
# these if every client you use is something else.
MONITOR_USER=monuser
MONITOR_PASS=secret
POLL_INTERVAL=5

# --- protect the Docker host itself (optional) -----------------------------
# When true, upsmon runs inside the container and executes SHUTDOWN_CMD on low
# battery. The container needs a way to actually power the host off — see
# "Shutting down the host" in the README.
RUN_UPSMON=false
#SHUTDOWN_CMD=/sbin/shutdown -h +0

# --- misc ------------------------------------------------------------------
DEBUG_LEVEL=0
TZ=UTC
